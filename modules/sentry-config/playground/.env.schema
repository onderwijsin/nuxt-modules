# @plugin(@varlock/proton-pass-plugin)
# @initProtonPass(id=nuxt-modules, personalAccessToken=$PROTON_PASS_PERSONAL_ACCESS_TOKEN)
# @generateTsTypes(path=./env.d.ts)
# ---

# @type=protonPassPersonalAccessToken @sensitive @internal @optional
PROTON_PASS_PERSONAL_ACCESS_TOKEN=

# Keep the playground disabled when no Sentry DSN is available.
# @type=string @optional
SENTRY_ORG=protonPass(nuxt-modules, pass://nuxt-modules/sentry-config/SENTRY_ORG, allowMissing=true)

# @type=string @optional
SENTRY_PROJECT=protonPass(nuxt-modules, pass://nuxt-modules/sentry-config/SENTRY_PROJECT, allowMissing=true)

# @type=url @optional
SENTRY_DSN=protonPass(nuxt-modules, pass://nuxt-modules/sentry-config/SENTRY_DSN, allowMissing=true)

# @type=string @sensitive @optional
SENTRY_AUTH_TOKEN=protonPass(nuxt-modules, pass://nuxt-modules/sentry-config/SENTRY_AUTH_TOKEN, allowMissing=true)

# This is a safe local/CI setting; source-map uploads are opt-in.
# @type=boolean
SENTRY_UPLOAD_SOURCE_MAPS=false
