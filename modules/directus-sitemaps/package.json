{
  "name": "@onderwijsin/nuxt-directus-sitemaps",
  "version": "0.1.0",
  "description": "Config-driven @nuxtjs/sitemap sources backed by Directus collections.",
  "homepage": "https://github.com/onderwijsin/nuxt-modules#readme",
  "bugs": {
    "url": "https://github.com/onderwijsin/nuxt-modules/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Remi Huigen",
    "email": "remihuigen@proton.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onderwijsin/nuxt-modules.git",
    "directory": "modules/directus-sitemaps"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build && nuxt prepare playground"
  },
  "dependencies": {
    "@directus/sdk": "catalog:",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxtjs/sitemap": "catalog:",
    "@onderwijsin/nuxt-directus": "workspace:^",
    "@onderwijsin/nuxt-directus-config": "workspace:^",
    "@onderwijsin/nuxt-module-utils": "workspace:^",
    "defu": "catalog:",
    "h3": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
