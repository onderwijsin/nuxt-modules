{
  "name": "@onderwijsin/nuxt-redirects",
  "version": "0.1.0",
  "description": "Provider-agnostic dynamic redirects for Nuxt.",
  "license": "MIT",
  "author": {
    "name": "Remi Huigen",
    "email": "remihuigen@proton.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onderwijsin/nuxt-modules.git",
    "directory": "modules/redirects"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/source": {
      "types": "./dist/runtime/source.d.ts",
      "import": "./dist/runtime/source.js"
    },
    "./runtime/refresh-task": {
      "types": "./dist/runtime/tasks/refresh.d.ts",
      "import": "./dist/runtime/tasks/refresh.js"
    },
    "./runtime/store": {
      "types": "./dist/runtime/app/stores/redirects.d.ts",
      "import": "./dist/runtime/app/stores/redirects.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build && nuxt prepare playground"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@onderwijsin/nuxt-module-utils": "workspace:^",
    "@pinia/nuxt": "catalog:",
    "defu": "catalog:",
    "h3": "catalog:",
    "nitropack": "catalog:",
    "ohash": "catalog:",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "regexparam": "catalog:",
    "ufo": "catalog:",
    "unstorage": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
