{
  "name": "@onderwijsin/nuxt-ui-form-extensions",
  "version": "0.2.2",
  "description": "Nuxt UI form extensions.",
  "homepage": "https://github.com/onderwijsin/nuxt-modules#readme",
  "bugs": {
    "url": "https://github.com/onderwijsin/nuxt-modules/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onderwijsin/nuxt-modules.git",
    "directory": "modules/ui-form-extensions"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/ui": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:",
    "module-utils": "workspace:*",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
