# @plugin(@varlock/proton-pass-plugin)
# @initProtonPass(id=nuxt-modules, personalAccessToken=$PROTON_PASS_PERSONAL_ACCESS_TOKEN)
# @generateTsTypes(path=./env.d.ts)
# ---

# @type=protonPassPersonalAccessToken @sensitive @internal @optional
PROTON_PASS_PERSONAL_ACCESS_TOKEN=

# Loops is the active playground provider.
# @type=string @required
LOOPS_LIST_ID=protonPass(nuxt-modules, pass://nuxt-modules/newsletter-signup/LOOPS_LIST_ID)

# @type=string @sensitive @required
LOOPS_API_KEY=protonPass(nuxt-modules, pass://nuxt-modules/newsletter-signup/LOOPS_API_KEY)

# Mailchimp fields are optional while Loops is selected, but remain available for provider testing.
# @type=string @optional
MAILCHIMP_AUDIENCE_ID=protonPass(nuxt-modules, pass://nuxt-modules/newsletter-signup/MAILCHIMP_AUDIENCE_ID, allowMissing=true)

# @type=string @sensitive @optional
MAILCHIMP_API_KEY=protonPass(nuxt-modules, pass://nuxt-modules/newsletter-signup/MAILCHIMP_API_KEY, allowMissing=true)

# @type=string @optional
MAILCHIMP_SERVER=protonPass(nuxt-modules, pass://nuxt-modules/newsletter-signup/MAILCHIMP_SERVER, allowMissing=true)
