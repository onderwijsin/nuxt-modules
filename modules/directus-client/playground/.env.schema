# @plugin(@varlock/proton-pass-plugin)
# @initProtonPass(id=nuxt-modules, personalAccessToken=$PROTON_PASS_PERSONAL_ACCESS_TOKEN)
# @generateTsTypes(path=./env.d.ts)
# ---

# @type=protonPassPersonalAccessToken @sensitive @internal @optional
PROTON_PASS_PERSONAL_ACCESS_TOKEN=

# @type=url @required
DIRECTUS_URL=protonPass(nuxt-modules, pass://nuxt-modules/directus-client/DIRECTUS_URL)

# @type=string @sensitive @required
DIRECTUS_STATIC_TOKEN=protonPass(nuxt-modules, pass://nuxt-modules/directus-client/DIRECTUS_STATIC_TOKEN)

# @type=string @sensitive @required
DIRECTUS_INTROSPECTION_TOKEN=protonPass(nuxt-modules, pass://nuxt-modules/directus-client/DIRECTUS_INTROSPECTION_TOKEN)

# @type=string @sensitive @optional
DIRECTUS_PREVIEW_TOKEN=protonPass(nuxt-modules, pass://nuxt-modules/directus-client/DIRECTUS_PREVIEW_TOKEN, allowMissing=true)

# @type=boolean @optional
DIRECTUS_AUTH_COOKIE_SECURE=protonPass(nuxt-modules, pass://nuxt-modules/directus-client/DIRECTUS_AUTH_COOKIE_SECURE, allowMissing=true)

# @type=url @optional
DIRECTUS_PASSWORD_RESET_URL=protonPass(nuxt-modules, pass://nuxt-modules/directus-client/DIRECTUS_PASSWORD_RESET_URL, allowMissing=true)
