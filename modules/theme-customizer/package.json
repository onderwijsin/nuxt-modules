{
  "name": "@onderwijsin/nuxt-theme-customizer",
  "version": "0.2.8",
  "description": "Nuxt module for runtime theme selection and custom color editing in Nuxt UI.",
  "homepage": "https://github.com/onderwijsin/nuxt-modules#readme",
  "bugs": {
    "url": "https://github.com/onderwijsin/nuxt-modules/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Remi Huigen",
    "email": "remihuigen@proton.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onderwijsin/nuxt-modules.git",
    "directory": "modules/theme-customizer"
  },
  "style": "./dist/runtime/index.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "style": "./dist/runtime/index.css",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground"
  },
  "dependencies": {
    "@iconify-json/lucide": "catalog:",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/ui": "catalog:",
    "@onderwijsin/nuxt-module-utils": "workspace:^",
    "@pinia/nuxt": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "h3": "catalog:",
    "nitropack": "catalog:",
    "ofetch": "catalog:",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "scule": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
