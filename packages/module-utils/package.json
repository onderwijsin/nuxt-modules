{
  "name": "@onderwijsin/nuxt-module-utils",
  "version": "0.5.1",
  "description": "Shared runtime and Nuxt module utilities for Onderwijs in modules.",
  "homepage": "https://github.com/onderwijsin/nuxt-modules#readme",
  "bugs": {
    "url": "https://github.com/onderwijsin/nuxt-modules/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Remi Huigen",
    "email": "remihuigen@proton.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onderwijsin/nuxt-modules.git",
    "directory": "packages/module-utils"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./build": {
      "types": "./dist/build/index.d.mts",
      "import": "./dist/build/index.mjs",
      "default": "./dist/build/index.mjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.mts",
      "import": "./dist/shared/index.mjs",
      "default": "./dist/shared/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs",
      "default": "./dist/server/index.mjs"
    },
    "./app": {
      "types": "./dist/app/index.d.mts",
      "import": "./dist/app/index.mjs",
      "default": "./dist/app/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs",
      "default": "./dist/types.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@directus/sdk": "catalog:",
    "@nuxt/schema": "catalog:",
    "consola": "catalog:",
    "h3": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "scule": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
