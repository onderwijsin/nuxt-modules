{
  "name": "module-utils",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "h3": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:",
    "consola": "catalog:",
    "scule": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
