{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "*.config.ts",
    "scripts/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.vue",
    "modules/**/*.ts",
    "modules/**/*.vue"
  ]
}
