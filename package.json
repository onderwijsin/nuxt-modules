{
  "name": "@onderwijsin/nuxt-modules",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Remi Huigen",
    "email": "remihuigen@proton.me"
  },
  "type": "module",
  "scripts": {
    "dev:utils": "pnpm --filter @onderwijsin/nuxt-module-utils dev",
    "build:utils": "pnpm --filter @onderwijsin/nuxt-module-utils build",
    "dev:prepare": "pnpm --recursive --if-present run dev:prepare",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "build": "pnpm --filter './packages/*' --filter './modules/*' --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "pnpm --recursive --if-present run e2e",
    "pack:packages": "node scripts/pack-packages.mjs",
    "validate:external-consumer": "node scripts/external-consumer.mjs",
    "ci:detect-changes": "node scripts/ci/detect-changes.mjs",
    "validate:packages": "node scripts/validate-packages.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "postinstall": "husky || true"
  },
  "devDependencies": {
    "@changesets/changelog-git": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "nuxt": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.1"
}
